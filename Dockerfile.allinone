# All-in-one image: FastAPI + nginx (static Next export), same origin.
#
#   browser ──► kontactiq.com (nginx :80)
#                 ├── /            static Next export
#                 └── /api/*       proxy → 127.0.0.1:8000 (FastAPI)
#
# Mongo and Redis are separate Coolify database resources.

FROM node:22-alpine AS web
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web ./
RUN npm run build:static

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor curl \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

WORKDIR /app
COPY apps/api/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY apps/api/app ./app
COPY deploy/nginx.allinone.conf /etc/nginx/conf.d/default.conf
COPY deploy/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY --from=web /web/out /usr/share/nginx/html

RUN mkdir -p /data /var/log/nginx
ENV WASIGNAL_DATA_DIR=/data \
    PYTHONUNBUFFERED=1

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --start-period=25s --retries=5 \
    CMD curl -fsS http://127.0.0.1/healthz || exit 1

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
