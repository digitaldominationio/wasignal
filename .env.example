# API
WASIGNAL_ENV=dev
WASIGNAL_DATA_DIR=./data

# LLM: leave the key empty to run offline with the deterministic echo provider.
# Paste an OpenRouter key and the provider is selected automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_X_TITLE=Wasignal
# WASIGNAL_LLM_PROVIDER=openrouter

# Generic OpenAI-compatible endpoint (alternative to OpenRouter)
WASIGNAL_LLM_API_KEY=
WASIGNAL_LLM_BASE_URL=https://api.openai.com/v1
WASIGNAL_LLM_MODEL=gpt-4o-mini

# WhatsApp transport
WASIGNAL_CHANNEL=stub
WASIGNAL_META_TOKEN=
WASIGNAL_META_PHONE_NUMBER_ID=
WASIGNAL_META_VERIFY_TOKEN=wasignal-verify

# Behaviour
WASIGNAL_HUMAN_PAUSE_SECONDS=600
WASIGNAL_TICK_SECONDS=15
WASIGNAL_SEED_DEMO=1
WASIGNAL_INTERNAL_KEY=dev-internal-key
WASIGNAL_MODEL_CACHE_SECONDS=900

# Split deployment (frontend on Cloudflare, API on a server)
# WASIGNAL_CORS_ORIGINS=https://app.wasignal.com,https://wasignal.pages.dev
# WASIGNAL_COOKIE_DOMAIN=.wasignal.com
# WASIGNAL_COOKIE_SAMESITE=lax
# WASIGNAL_COOKIE_SECURE=true

# Web
API_BASE_URL=http://127.0.0.1:8000
# Direct API calls from a hosted frontend (also inlined at build time):
# NEXT_PUBLIC_API_BASE_URL=https://api.wasignal.com
